[Unit]
Description=OpenVPN per-client traffic metrics collector
Documentation=https://github.com/AliHMIMS/openvpn-metrics
After=network.target openvpn.service openvpn-server@server.service
Wants=network.target

[Service]
Type=simple
# Edit these to match your server: interface, status file path (the same one
# `status` writes to in the OpenVPN server config), --status-interval to
# match the status file's refresh seconds, and --retention for how much
# history to keep (bounds the database size; drop the flag to keep forever).
ExecStart=/usr/local/bin/openvpn-metrics collect \
    --interface tun0 \
    --status-file /var/log/openvpn/status.log \
    --status-interval 10 \
    --retention 48h \
    --dns \
    --db /var/lib/openvpn-metrics/metrics.db
Restart=on-failure
RestartSec=5

# Runs as unrestricted root — deliberately. tcpdump needs raw sockets and
# (on Debian/Ubuntu) drops privileges to the 'tcpdump' user at startup, and
# the status file is owned by the OpenVPN service user; sandboxing directives
# (User=, CapabilityBoundingSet=, AmbientCapabilities=, NoNewPrivileges=)
# break one or both in ways that only appear under systemd, causing
# "Operation not permitted" restart loops. If you re-harden, test with:
#   systemctl restart openvpn-metrics && journalctl -u openvpn-metrics -n 8

[Install]
WantedBy=multi-user.target
