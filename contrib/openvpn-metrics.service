[Unit]
Description=OpenVPN per-client traffic metrics collector
Documentation=https://github.com/AliHMIMS/openvpn-metrics
After=network.target openvpn.service openvpn-server@server.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/openvpn-metrics collect \
    --interface tun0 \
    --status-file /var/log/openvpn/status.log \
    --db /var/lib/openvpn-metrics/metrics.db
Restart=on-failure
RestartSec=5

# Hardening: capturing needs CAP_NET_RAW/CAP_NET_ADMIN, nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openvpn-metrics
StateDirectory=openvpn-metrics
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
